{
  "name": "pinterest-media-downloader",
  "version": "2.0.0",
  "description": "Universal Pinterest media scraper & downloader. Supports all Pinterest URL types (pin.it shortlinks, mobile, international ccTLDs, idea pins, raw IDs) with zero dependencies and CLI support.",
  "main": "src/index.js",
  "module": "src/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    }
  },
  "bin": {
    "pinterest-dl": "bin/cli.js"
  },
  "scripts": {
    "test": "node test/test-all-urls.js",
    "lint": "node -c src/*.js src/*.mjs bin/*.js test/*.js"
  },
  "keywords": [
    "pinterest",
    "download",
    "video",
    "image",
    "scraper",
    "search",
    "pin",
    "media",
    "downloader",
    "pin.it",
    "idea-pin"
  ],
  "author": "KakashiSan69",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KakashiSan69/pinterest-media-downloader.git"
  },
  "bugs": {
    "url": "https://github.com/KakashiSan69/pinterest-media-downloader/issues"
  },
  "homepage": "https://github.com/KakashiSan69/pinterest-media-downloader#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE",
    "test-results.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
